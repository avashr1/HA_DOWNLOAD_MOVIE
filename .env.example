# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# Base URL of your Radarr instance (no trailing /api)
RADARR_URL=http://your-radarr-host:7878

# Radarr API key: Radarr > Settings > General > Security > API Key
RADARR_API_KEY=your-radarr-api-key-here

# ID of the quality profile new movies should use
RADARR_QUALITY_PROFILE_ID=1

# Root folder (as Radarr sees it) where movies are stored
RADARR_ROOT_FOLDER_PATH=/path/to/movies
